<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Native window theme, used before Compose draws (startup window, Android 12+ splash).
        Light here; values-night/themes.xml is the dark variant, so the window follows the
        system dark mode like the Compose theme and never flashes the wrong background.
        Once running, MainActivity.enableEdgeToEdge() manages the system bars.
    -->
    <style name="Theme.MADCurrencyConverter" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <!-- Dark status/navigation bar icons on the light background. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
